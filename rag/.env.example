# 知识库助手配置
#
# 用法：复制为 .env.local 并填入真实值。
#   cp .env.example .env.local
#
# .env.local 优先于 .env；命令行传入的环境变量优先于两者。
# 全部留空也能运行：检索退化为纯关键词，回答返回检索到的原文片段。

# ---------------------------------------------------------------------------
# 数据库
# ---------------------------------------------------------------------------

# SQLite 数据库文件路径（默认 ./data/kb.db）
# KB_DATABASE_PATH=./data/kb.db

# SQLite 驱动：默认自动选择 node:sqlite（Node 22+ 内置）
# 若运行环境不可用，可安装 better-sqlite3 后设为 better-sqlite3
# KB_SQLITE_DRIVER=better-sqlite3

# ---------------------------------------------------------------------------
# 语义检索（Embedding）
#
# 不配置 → 检索退化为纯关键词模式，功能不中断。
# 配置后 → 关键词与语义双通道经 RRF 融合，显著提升改写提问的命中率。
# ---------------------------------------------------------------------------

# 模型名（必填，配置后语义检索才会启用）
# KB_EMBEDDING_MODEL=text-embedding-3-small

# 向量维度（必填，必须与模型实际输出一致，否则启动时探测会报错）
# KB_EMBEDDING_DIM=1536

# OpenAI 兼容端点（默认 https://api.openai.com）
# KB_EMBEDDING_BASE_URL=https://api.openai.com

# API 密钥
# KB_EMBEDDING_API_KEY=

# 指令前缀：部分模型要求文档与查询使用不同前缀
# E5 系列通常为 "passage: " / "query: "
# BGE 中文模型通常为 "" / "为这个句子生成表示以用于检索相关文章："
# KB_EMBEDDING_DOC_PREFIX=
# KB_EMBEDDING_QUERY_PREFIX=

# ---------------------------------------------------------------------------
# 生成式回答（LLM）
#
# 不配置 → 返回带引用的检索原文片段，拒答能力不受影响。
# 配置后 → 生成自然语言回答，并执行生成后校验（claim 级忠实度判定）。
# ---------------------------------------------------------------------------

# 模型名（必填，配置后生成式回答才会启用）
# KB_LLM_MODEL=deepseek-chat
# 可选：供网页插件模型下拉框使用，逗号分隔；实际请求会把所选名称传给兼容端点
# KB_LLM_MODELS=deepseek-chat,deepseek-reasoner

# OpenAI 兼容端点（默认 https://api.openai.com）
# KB_LLM_BASE_URL=https://api.deepseek.com

# API 密钥
# KB_LLM_API_KEY=

# 采样温度（默认 0.2）
# KB_LLM_TEMPERATURE=0.2

# 最大输出长度
# KB_LLM_MAX_TOKENS=2048

# ---------------------------------------------------------------------------
# 常用供应商示例（去掉注释即可使用）
# ---------------------------------------------------------------------------

# --- DeepSeek ---
# KB_LLM_MODEL=deepseek-chat
# KB_LLM_BASE_URL=https://api.deepseek.com
# KB_LLM_API_KEY=sk-xxxxxxxx

# --- 阿里通义（DashScope 兼容模式）---
# KB_EMBEDDING_MODEL=text-embedding-v3
# KB_EMBEDDING_DIM=1024
# KB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# KB_EMBEDDING_API_KEY=sk-xxxxxxxx
# KB_LLM_MODEL=qwen-plus
# KB_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
# KB_LLM_API_KEY=sk-xxxxxxxx

# --- 智谱 GLM ---
# KB_EMBEDDING_MODEL=embedding-3
# KB_EMBEDDING_DIM=2048
# KB_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# KB_EMBEDDING_API_KEY=xxxxxxxx
# KB_LLM_MODEL=glm-4-plus
# KB_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# KB_LLM_API_KEY=xxxxxxxx

# --- 本地 Ollama（无需密钥）---
# KB_EMBEDDING_MODEL=nomic-embed-text
# KB_EMBEDDING_DIM=768
# KB_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# KB_EMBEDDING_API_KEY=ollama
# KB_LLM_MODEL=qwen2.5:7b
# KB_LLM_BASE_URL=http://127.0.0.1:11434
# KB_LLM_API_KEY=ollama
